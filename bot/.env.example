# ============================================================
#  FADE BOT — Railway Variables
#  Railway > projen > servis > Variables > Raw Editor'a yapıştır
#  ve kendi değerlerini yaz.
# ============================================================

# ---------- 1) TELEGRAM (zorunlu) ----------
# @BotFather > /newbot ile al
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Free kanal: @kullaniciadi VEYA -100... sayısal id
FREE_CHANNEL_ID=@cryptopumpradarr
FREE_CHANNEL_LINK=https://t.me/cryptopumpradarr

# VIP kanal: ÖZEL kanal olduğu için MUTLAKA sayısal id (-100...)
# Nasıl bulunur: README > "VIP kanal id'si nasıl bulunur"
VIP_CHANNEL_ID=-1001234567890
# NOT: VIP için sabit davet linki ayarı YOK, bilerek. Halka açık bir davet linki
# ödemeyi atlatır. VIP'e giriş yalnızca ödeme sonrası botun ürettiği, kişiye özel,
# tek kullanımlık linkle olur. Eski VIP_INVITE_LINK değişkenini Railway'den silebilirsin.

# Botun kullanıcı adı (opsiyonel; boş bırakırsan açılışta getMe ile otomatik alınır)
BOT_USERNAME=

# Yenileme: daha önce VIP olmuş kişilere % indirim. 0 = kapalı.
RENEW_DISCOUNT_PCT=0

# Kanal adı/bio/logo/sabit mesaj otomatik uygulanır (sürüm başına bir kez).
BRAND_AUTO=true
BRAND_FREE_TITLE=Crypto Pump Radar
BRAND_VIP_TITLE=Crypto Pump Radar · VIP

# Kendi Telegram sayısal id'n (@userinfobot ile bul). Virgülle birkaç kişi olabilir.
# Admin komutları ve ödeme bildirimleri buraya gider.
ADMIN_IDS=123456789

# ---------- 2) VERİTABANI (zorunlu) ----------
# Railway'de "+ New > Database > PostgreSQL" ekle. Sonra bu servisin
# Variables kısmında Raw Editor'a AYNEN şunu yaz (tırnaksız):
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Railway bunu otomatik dolduracak. Tabloları bot kendisi kurar,
# SQL çalıştırman GEREKMEZ.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ---------- 3) NOWPAYMENTS (ödeme almak için) ----------
# nowpayments.io > Settings > Payments > API keys
NOWPAYMENTS_API_KEY=
# nowpayments.io > Settings > Payments > Instant Payment Notifications
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_CURRENCY=usd

# Railway'in verdiği public domain. SONUNDA / OLMASIN.
# Railway > Settings > Networking > Generate Domain ile al.
PUBLIC_URL=https://xxxx.up.railway.app

# Planlar:  ad:fiyatUSD:gün  (virgülle ayrılır)
PLANS=1mo:49:30,3mo:129:90,12mo:399:365
# (Başında "_" olan plan gizli/admin planıdır; şu an kullanılmıyor.)

# ---------- 4) TARAMA AYARLARI ----------
SCAN_TF=15m                 # 5m | 15m | 30m | 1h
SCAN_MIN_CHG=8              # 24s'te min % hareket (aday eşiği)
SCAN_TOP=60                 # her yönde kaç coin incelenir
SCAN_INTERVAL_SEC=90        # tur arası saniye
SCAN_DIR=both               # both | S (sadece short) | L (sadece long)

MIN_GRADE_VIP=C             # VIP'e giden min sınıf (A>B>C>D)
MIN_GRADE_FREE=B            # free'ye giden min sınıf

# ---------- 4b) FREE KANAL VİTRİN KURALLARI ----------
FREE_DELAY_MIN=40           # gecikme (dakika)
FREE_SIGNALS_PER_DAY=1      # günde en fazla kaç sinyal free'ye
FREE_ONLY_WINNING=true      # SADECE kârda olan pozisyonu göster
FREE_MIN_OPEN_R=0.5         # "kazanıyor" sayılmak için min R
FREE_PENDING_MAX_H=14       # bu kadar saat kâra geçmezse sessizce vazgeç

WS_CONFIRM=true             # sinyal öncesi canlı tape teyidi
WS_CONFIRM_SEC=45
SECTOR_CHECK=true           # CoinGecko sektör kontrolü

# ---------- 5) YAYIN ----------
POST_FREE=true
POST_VIP=true
DAILY_HOUR=9                # günlük analiz saati (TR)
WEEKLY_DAY=1                # 1=Pazartesi, haftalık tablo
MONTHLY_DAY=1               # ayın kaçında aylık tablo
TZ_OFFSET=3                 # TR = UTC+3

# İLK KURULUMDA true YAP: hiçbir şey yayınlanmaz, sadece log'a yazar.
# Her şeyin doğru çalıştığını görünce false yap.
DRY_RUN=true

# ---------- 5b) EĞİTİM İÇERİĞİ ----------
# 25 derslik kütüphane sırayla yayınlanır, tekrar etmez.
EDU_ON=true
EDU_HOUR=13                 # TR saati (günlük analizden ayrı olsun)
EDU_EVERY_DAYS=1            # 1=her gün, 2=gün aşırı

# ---------- 5c) DASHBOARD ----------
# Uzun ve rastgele bir metin yaz. Panel: PUBLIC_URL/dash?key=BURAYA
# Telegram'dan /dash yazarsan bot linki sana gönderir.
DASHBOARD_KEY=

# ---------- 5d) RAILWAY TASARRUF ----------
# Ölü saatlerde (TR 00:00-04:00) tarama aralığını uzatır. Aynı container,
# daha az CPU. Sistem zaten o saatlerde sinyal üretmiyor.
ECO_MODE=true
ECO_FACTOR=3
ECO_FROM_HOUR=0
ECO_TO_HOUR=4

# ---------- 5e) HABER MOTORU ----------
# RSS tabanlı, API ANAHTARI GEREKMEZ. Türkçe kaynaklar önceliklidir.
NEWS_ON=true
NEWS_MIN_SCORE=70           # VIP: yalnız çok önemli haber (günde en çok 1)
NEWS_CHECK_MIN=20           # kaç dakikada bir kaynaklara bakılsın
NEWS_BREAKING_MINUTES=90    # bundan eski haber "BREAKING" sayılmaz, akşam özetine kalır
NEWS_MAX_PER_DAY=1          # VIP: günde en fazla kaç haber
NEWS_TAG_COOLDOWN_H=6       # aynı konu (örn. SECURITY) en fazla bu kadar saatte bir
# FREE kanal çok daha seçici: sadece büyük haber, günde en fazla 1, VIP'ten sonra
NEWS_FREE_MIN_SCORE=38
NEWS_FREE_MAX_PER_DAY=4
NEWS_FREE_GAP_MIN=90        # iki free haber arası en az dakika
NEWS_DIGEST=false           # akşam özeti kapalı (free günde 4 haber alır)
NEWS_DIGEST_HOUR=19         # günlük haber özeti saati (TR)
# Kaynakları değiştirmek istersen (virgülle ayır). Boş bırakırsan
# varsayılan Türkçe + İngilizce kaynaklar kullanılır:
# NEWS_FEEDS=https://kriptokoin.com/feed/,https://coin-turk.com/feed

# ---------- 6) RİSK / SİSTEM (CFG_ ön ekiyle hepsi ezilebilir) ----------
CFG_acct=1000               # örnek hesap büyüklüğü (mesajlarda $ karşılığı için)
CFG_riskPct=1               # işlem başına risk %
CFG_maxOpen=2               # aynı anda max pozisyon
CFG_dailyStopR=-2           # gün -2R'ye inerse sistem durur
CFG_reSignalMin=60          # aynı coine tekrar sinyal için bekleme (dk)
CFG_minPumpPct=15           # min impulse %
CFG_trackBars=32            # sinyal takip süresi (mum)
CFG_feeBps=5                # taker komisyon (bps, tek bacak)
CFG_extraSlipBps=5          # tahmini kayma (bps, tek bacak)

# ---------- 7) MAKRO PENCERE ----------
# Makro veri anlarında (iş gücü raporu, FOMC, CPI) yeni pozisyon AÇILMAZ (veto).
# NFP otomatik hesaplanır (ayın ilk Cuması, New York saatiyle 08:30). Diğerlerini sen ekle:
#   MACRO_EVENTS=2026-11-04T19:00:00Z|FOMC,2026-11-12T13:30:00Z|CPI
# Ayrıca yüksek puanlı bir MACRO haberi çıkınca veto 30 dakika açılır.
MACRO_EVENTS=

# ---------- 8) VIP İÇERİĞİ KORUMA ----------
# VIP gönderileri iletilemez/kaydedilemez (sinyallerin free gruplara kopyalanmasını zorlaştırır)
VIP_PROTECT_CONTENT=true

# ---------- 9) ÖDEME GÜVENLİĞİ ----------
# true: imzası geçersiz IPN'leri NOWPayments'a sormadan reddeder. Varsayılan false çünkü ödeme
# her durumda NOWPayments API'sinden yeniden doğrulanır; imza algoritmasında bir sapma olursa
# gerçek müşteriler kilitlenmesin diye.
NOWPAYMENTS_REQUIRE_SIG=false

# ---------- 10) V1K MOTORU (gölge kayıt + free vitrin) ----------
SHADOW_ENGINES=true         # adayları kanala göndermeden kaydet
V1K_PUBLISH=true            # free kanalda kârda olan v1k pozisyonlarını göster (sonuçlar kazanç/kayıp hep yayınlanır)
V1K_VIP=false               # VIP'e anlık v1k sinyali: kapalı, sahibi karar verene kadar
V1K_FREE_MIN_PROFIT=3       # pozisyonun % kaç kârda olunca vitrine çıkar
# Telegram'dan: /v1k on|off|resume|status (acil kapatma) · /karne (tüm kayıt)
